<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Safari requires app extensions to be sandboxed. -->
  <key>com.apple.security.app-sandbox</key><true/>
  <!-- Reach rampartd's user-mode socket and the per-user web state (seen domains, allowlist).
       Temporary-exception entitlements are honoured for ad-hoc / Developer ID builds, not App Store. -->
  <key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
  <array><string>/Library/Application Support/Rampart/</string></array>
  <key>com.apple.security.temporary-exception.files.absolute-path.read-write</key>
  <array><string>/var/run/rampart.sock</string></array>
</dict>
</plist>
