{
  "manifest_version": 3,
  "name": "RamPart Web Protection",
  "version": "0.1.0",
  "description": "Checks every page as it loads for scams, look-alike domains, fake CAPTCHAs (ClickFix), clipboard hijacks and wallet drainers. Verdicts come from RamPart on your Mac.",
  "default_locale": "en",
  "permissions": ["nativeMessaging", "webNavigation", "storage", "tabs", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"], "persistent": false },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["shared/clipboard-main.js"], "run_at": "document_start", "world": "MAIN", "all_frames": false },
    { "matches": ["http://*/*", "https://*/*"], "js": ["shared/heuristics.js", "shared/tamper.js", "content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false }
  ],
  "action": { "default_title": "RamPart Web Protection", "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "web_accessible_resources": [{ "resources": ["interstitial.html", "interstitial.css"], "matches": ["<all_urls>"] }],
  "icons": { "128": "icons/icon128.png", "48": "icons/icon48.png", "16": "icons/icon16.png" }
}
