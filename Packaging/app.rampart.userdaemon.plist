<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- No-root protection: a per-user LaunchAgent that runs the bundled rampartd in --user mode.
     Ships at Rampart.app/Contents/Library/LaunchAgents/ for SMAppService.agent(plistName:)
     (BundleProgram is relative to the app bundle). Never changes system settings. -->
<plist version="1.0">
<dict>
    <key>Label</key><string>app.rampart.userdaemon</string>
    <key>BundleProgram</key><string>Contents/Helpers/rampartd</string>
    <key>ProgramArguments</key>
    <array>
        <string>rampartd</string>
        <string>--user</string>
    </array>
    <key>AssociatedBundleIdentifiers</key><array><string>app.rampart.app</string></array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
    <key>ThrottleInterval</key><integer>10</integer>
    <key>ProcessType</key><string>Background</string>
    <key>LowPriorityBackgroundIO</key><true/>
    <key>Nice</key><integer>5</integer>
</dict>
</plist>
