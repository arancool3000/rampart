<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Bundled copy for SMAppService.daemon(plistName:) (Contents/Library/LaunchDaemons). Needs a Developer ID
     signature in practice; the .pkg / install.sh path uses ../app.rampart.daemon.plist instead. -->
<plist version="1.0">
<dict>
    <key>Label</key><string>app.rampart.daemon</string>
    <key>BundleProgram</key><string>Contents/MacOS/rampartd</string>
    <key>AssociatedBundleIdentifiers</key><array><string>app.rampart.app</string></array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>10</integer>
</dict>
</plist>
